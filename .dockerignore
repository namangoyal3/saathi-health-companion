# Never bake secrets, venvs, or local caches into the image
.env
.env.*
!.env.example

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

.git/
.github/
.gitignore

# IDE + macOS
.vscode/
.idea/
.DS_Store

# Local-only
.worktrees/
data/memories/
node_modules/

# Docs only — not needed in runtime image
docs/
*.md
!README.md
