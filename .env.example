# Saath — environment template. Copy to .env; never commit .env.
# See docs/docs-verification-2026-04-23.md for why certain beta headers from the
# Tech Spec are intentionally omitted.

# --- App ---
ENVIRONMENT=dev                 # dev | demo | prod
APP_BASE=http://localhost:8080
LOG_LEVEL=INFO
JWT_SECRET=change-me-64-chars-minimum

# --- Database / Redis ---
DATABASE_URL=postgresql+asyncpg://saath:saath@localhost:5432/saath
REDIS_URL=redis://localhost:6379/0

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Only include beta headers we actually use. Memory tool does NOT need a header.
# Add context-management-2025-06-27 only when enabling context-editing strategies.
ANTHROPIC_BETA_HEADERS=
MODEL_OPUS=claude-opus-4-7
MODEL_HAIKU=claude-haiku-4-5-20251001

# --- Memory tool (filesystem adapter root) ---
MEMORY_ROOT=./data/memories

# --- Sarvam ---
SARVAM_API_KEY=

# --- Groq Whisper (web portal voice input, Telegram voice notes) ---
# Free tier at console.groq.com. Without this key, voice input is disabled
# and users see a clear "not configured" message instead of a hang.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Google Cloud (TTS + STT) ---
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp.json

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Telephony (Day 3) ---
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_FROM_NUMBER=+91XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Wearable (Day 3) ---
# Shared secret for HMAC-SHA256 signing between the Android companion app and
# /wearable/samsung/webhook. If unset or left at the default, the webhook
# logs an ERROR and accepts unsigned posts — DO NOT leave this unset in prod.
# Suggested: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
WEARABLE_HMAC_SECRET=change-me-wearable-hmac-secret

# --- Cloudflare R2 (Day 3+) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=saath-dev

# --- Langfuse (Day 2+) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
